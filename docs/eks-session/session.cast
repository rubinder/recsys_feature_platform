[753.998, "o", "\r\n\u001b[1;36m# 2/7 Build the API image (arm64) and push it to ECR\u001b[0m\r\n"]
[754.047, "o", "\u001b[1;32m$\u001b[0m docker build -t <ecr>/recsys-api:7d4880b .\r\n"]
